{
  "name": "a0-project",
  "version": "1.0.0",
  "license": "0BSD",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "admin": "npx --yes serve admin-update -l 3456",
    "predeploy:admin": "node scripts/copy-admin-icon.js",
    "deploy:admin": "npm run predeploy:admin && npx vercel admin-update --prod",
    "deploy:admin:preview": "npm run predeploy:admin && npx vercel admin-update",
    "deploy:firestore-rules": "npx firebase-tools deploy --only firestore:rules",
    "deploy:functions": "npx firebase-tools deploy --only functions",
    "deploy:admin:firebase": "npm run predeploy:admin && firebase deploy --only hosting,functions",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios --latest --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:android:apk": "eas build --platform android --profile preview",
    "update:production": "eas update --channel production",
    "update:preview": "eas update --channel preview",
    "notify:welcome": "node scripts/send-welcome-broadcast.js",
    "notify:welcome:dry": "node scripts/send-welcome-broadcast.js --dry-run",
    "submit:android": "eas submit --platform android --latest --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.0",
    "typescript": "^5.1.3"
  }
}
